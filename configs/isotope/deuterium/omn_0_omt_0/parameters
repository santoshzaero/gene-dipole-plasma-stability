c_surf_dipole =    1.2000000
c_dt_dipole =   0.10000000E-04
q0       =    0.0000000
shat     =    0.0000000
minor_r  =    1.0000000
major_R  =    1.0000000
dpdx_term= 'gradB_eq_curv'
dpdx_pm  =    0.0000000
norm_flux_projection  = F
/

&species
name   = 'ions'
omn    =    0
omt    =    0

mass   =    2.0
