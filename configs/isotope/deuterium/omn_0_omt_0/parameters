!n_procs_w =   8
!n_procs_x =   1
!n_procs_y =   1
!n_procs_z =   1
!n_procs_sim =     16
/

&box
n_spec =    2
nx0    =     1
nky0   =    1
nz0    =   32
nv0    =   48
nw0    =   32

kymin =   0.70000000
lv    =   3.50000
lw    =   12.2500
lx    =   1.00000
nexc  = 0
adapt_lx = F
ky0_ind =   1
/

&in_out
diagdir = './out'

read_checkpoint  = F
write_checkpoint = F

istep_field  =       1
istep_mom    =       1
istep_nrg    =       1
istep_omega  =       10
istep_vsp    =       0
istep_schpt  =       0
istep_energy =       1

write_std = T
/

&general
nonlinear =   F
comp_type = 'IV'
ntimesteps = 5000
calc_dt = T
!perf_vec  =  1 1 1 1 1 2 2 1 2
!nblocks   =      24
hyp_on_h =   F

